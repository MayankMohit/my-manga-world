# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000

# ---- Datastores ----
MONGODB_URI=mongodb://localhost:27017/shelf
REDIS_URL=redis://localhost:6379

# ---- Auth (secrets must be >= 32 chars and different from each other) ----
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---- Cloudflare R2 (private bucket) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shelf

# ---- Presigning ----
PRESIGN_UPLOAD_TTL=900
PRESIGN_DOWNLOAD_TTL=3600

# ---- Limits ----
MAX_UPLOAD_BYTES=1073741824
MAX_UNCOMPRESSED_BYTES=2147483648
MAX_ENTRIES=5000
MAX_STORAGE_BYTES_PER_USER=21474836480

# ---- Worker ----
WORKER_CONCURRENCY=2

# ---- Invites / signup ----
SIGNUPS_OPEN=false
INVITE_TTL=604800
BOOTSTRAP_ADMIN_EMAIL=

# ---- Logging ----
LOG_LEVEL=debug
